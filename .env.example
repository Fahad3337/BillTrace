# Copy this file to .env and adjust the values.

# Port the web server listens on
PORT=3000

# Secret used to sign session cookies. Generate a random one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# --- Database ---------------------------------------------------------------
# The app uses ONE of two backends:
#
#   DATABASE_URL set   -> cloud PostgreSQL (e.g. Supabase)
#   DATABASE_URL unset -> local SQLite file at DB_PATH (default, good for dev)
#
# Supabase: Project Settings -> Database -> Connection string (URI). Use the
# "Session pooler" or the direct connection, fill in your DB password, and add
# ?sslmode=require at the end.
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_REF.supabase.co:5432/postgres?sslmode=require

# Path to the local SQLite database file (used only when DATABASE_URL is unset).
DB_PATH=./data/app.db
