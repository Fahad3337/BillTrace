<%- include('../partials/header') %>
<%
  function qs(overrides) {
    const p = Object.assign({ q, sort, page }, overrides);
    return Object.entries(p)
      .filter(([, v]) => v !== '' && v != null)
      .map(([k, v]) => encodeURIComponent(k) + '=' + encodeURIComponent(v))
      .join('&');
  }
  // Server sends UTC ISO strings; the <time> element is localised by app.js,
  // and this is the no-JS fallback text.
  function utcFallback(iso) {
    if (!iso) return '';
    return iso.replace('T', ' ').slice(0, 16) + ' UTC';
  }
  // When sorted by date, break the list into day sections so a page of results
  // reads as a handful of days rather than one undifferentiated wall of rows.
  var groupByDate = sort === 'date_desc' || sort === 'date_asc';
  var colCount = currentUser.role === 'admin' ? 5 : 4;
%>

<div class="page-head">
  <div>
    <h1>Bill records <span class="muted">(<%= total %>)</span></h1>
    <% if (total > 0) { %>
      <p class="muted range-hint">Showing <%= rangeStart %>&ndash;<%= rangeEnd %> of <%= total %></p>
    <% } %>
  </div>
  <div class="actions">
    <a class="button" href="/bills/export.csv<%= q ? '?q=' + encodeURIComponent(q) : '' %>">Export CSV</a>
    <% if (currentUser.role === 'admin') { %>
      <a class="button primary" href="/bills/new">Add record</a>
    <% } %>
  </div>
</div>

<% if (flash) { %><p class="alert <%= flash.type === 'ok' ? 'ok' : 'error' %>"><%= flash.message %></p><% } %>

<form class="search" method="get" action="/">
  <input type="text" name="q" value="<%= q %>" placeholder="Enter the exact bill number">
  <input type="hidden" name="sort" value="<%= sort %>">
  <button type="submit">Search</button>
  <% if (q) { %><a class="button ghost" href="/">Clear</a><% } %>
</form>

<% if (bills.length === 0) { %>
  <% if (q) { %>
    <p class="empty">No bill has the number &ldquo;<%= q %>&rdquo;. Check it for a typo &mdash; the search matches the full bill number exactly.</p>
  <% } else { %>
    <p class="empty">No records yet.</p>
  <% } %>
<% } else { %>
<div class="table-wrap">
<table class="grid">
  <thead>
    <tr>
      <th><a href="/?<%= qs({ sort: sort === 'number_asc' ? 'number_desc' : 'number_asc', page: 1 }) %>">Bill number</a></th>
      <th><a href="/?<%= qs({ sort: sort === 'date_desc' ? 'date_asc' : 'date_desc', page: 1 }) %>">Date</a></th>
      <th>Note</th>
      <th>Last updated</th>
      <% if (currentUser.role === 'admin') { %><th></th><% } %>
    </tr>
  </thead>
  <tbody>
    <% var lastGroup = null; %>
    <% bills.forEach(function (b) { %>
    <% if (groupByDate) {
         var g = b.bill_date || 'No date';
         if (g !== lastGroup) { lastGroup = g; %>
    <tr class="date-group"><td class="date-group-cell" colspan="<%= colCount %>"><%= g %></td></tr>
    <% } } %>
    <tr>
      <td class="mono" data-label="Bill number"><%= b.bill_number %></td>
      <td class="nowrap" data-label="Date"><%= b.bill_date || '' %></td>
      <td data-label="Note"><%= b.note || '' %></td>
      <td class="muted" data-label="Last updated">
        <% var ts = b.updated_at || b.created_at; %>
        <% if (ts) { %><time class="localtime" datetime="<%= ts %>"><%= utcFallback(ts) %></time><% } %>
        <% if (b.updated_by_name || b.created_by_name) { %>
          by <%= b.updated_by_name || b.created_by_name %>
        <% } %>
      </td>
      <% if (currentUser.role === 'admin') { %>
      <td class="row-actions">
        <a href="/bills/<%= b.id %>/edit">Edit</a>
        <form method="post" action="/bills/<%= b.id %>/delete" data-confirm="Delete bill <%= b.bill_number %>?">
          <button type="submit" class="link danger">Delete</button>
        </form>
      </td>
      <% } %>
    </tr>
    <% }); %>
  </tbody>
</table>
</div>

<% if (pages > 1) { %>
<nav class="pager">
  <% if (page > 1) { %><a href="/?<%= qs({ page: page - 1 }) %>">&larr; Prev</a><% } %>
  <span>Page <%= page %> of <%= pages %></span>
  <% if (page < pages) { %><a href="/?<%= qs({ page: page + 1 }) %>">Next &rarr;</a><% } %>
</nav>
<% } %>
<% } %>

<%- include('../partials/footer') %>
