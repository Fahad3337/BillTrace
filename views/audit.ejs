<%- include('partials/header') %>
<%
  function summarise(row) {
    const d = row.details;
    if (!d) return '';
    if (d.values) {
      return Object.entries(d.values).map(([k, v]) => k + '=' + (v ?? '')).join(', ');
    }
    if (d.changes) {
      return Object.entries(d.changes)
        .map(([k, c]) => k + ': "' + (c.from ?? '') + '" → "' + (c.to ?? '') + '"')
        .join('; ');
    }
    if (d.username) return 'user: ' + d.username + (d.role ? ' (' + d.role + ')' : '');
    return JSON.stringify(d);
  }
%>

<%
  var auditQs = [];
  if (action) auditQs.push('action=' + encodeURIComponent(action));
  if (billNumber) auditQs.push('bill_number=' + encodeURIComponent(billNumber));
  var exportHref = '/audit/export.csv' + (auditQs.length ? '?' + auditQs.join('&') : '');
%>

<div class="page-head">
  <h1>Audit log <span class="muted">(<%= total %>)</span></h1>
  <div class="actions">
    <a class="button" href="<%= exportHref %>">Export CSV</a>
  </div>
</div>

<% if (typeof flash !== 'undefined' && flash) { %>
  <p class="alert <%= flash.type === 'ok' ? 'ok' : 'error' %>"><%= flash.message %></p>
<% } %>

<form class="search" method="get" action="/audit">
  <select name="action">
    <option value="">All actions</option>
    <% actions.forEach(function (a) { %>
      <option value="<%= a %>" <%= action === a ? 'selected' : '' %>><%= a %></option>
    <% }); %>
  </select>
  <input type="text" name="bill_number" value="<%= billNumber %>" placeholder="Bill number">
  <button type="submit">Filter</button>
  <% if (action || billNumber) { %><a class="button ghost" href="/audit">Clear</a><% } %>
</form>

<div class="table-wrap">
<table class="grid">
  <thead>
    <tr><th>When (UTC)</th><th>User</th><th>Action</th><th>Bill</th><th>Details</th><th></th></tr>
  </thead>
  <tbody>
    <% rows.forEach(function (r) { %>
    <tr>
      <td class="muted nowrap" data-label="When (UTC)"><%= r.ts.replace('T', ' ').slice(0, 19) %></td>
      <td data-label="User"><%= r.username || '—' %></td>
      <td data-label="Action"><span class="tag tag--<%= r.action %>"><%= r.action %></span></td>
      <td class="mono" data-label="Bill"><%= r.bill_number || '' %></td>
      <td class="details" data-label="Details"><%= summarise(r) %></td>
      <% if (r.action === 'delete' && r.details && r.details.values && r.details.values.bill_number) { %>
        <td class="row-actions"><form method="post" action="/audit/<%= r.id %>/restore" data-confirm="Restore bill <%= r.details.values.bill_number %>?"><button type="submit" class="link">Restore</button></form></td>
      <% } else if (r.action === 'update' && r.bill_id && r.bill_number && r.details && r.details.changes) { %>
        <td class="row-actions"><form method="post" action="/audit/<%= r.id %>/revert" data-confirm="Revert this change to bill <%= r.bill_number %>?"><button type="submit" class="link">Revert</button></form></td>
      <% } else { %>
        <td></td>
      <% } %>
    </tr>
    <% }); %>
  </tbody>
</table>
</div>

<% if (pages > 1) { %>
<nav class="pager">
  <% var base = 'action=' + encodeURIComponent(action) + '&bill_number=' + encodeURIComponent(billNumber); %>
  <% if (page > 1) { %><a href="/audit?<%= base %>&page=<%= page - 1 %>">&larr; Prev</a><% } %>
  <span>Page <%= page %> of <%= pages %></span>
  <% if (page < pages) { %><a href="/audit?<%= base %>&page=<%= page + 1 %>">Next &rarr;</a><% } %>
</nav>
<% } %>

<%- include('partials/footer') %>
